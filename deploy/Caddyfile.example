# Orion OS — Caddy reverse proxy (recommended).
#
# Install as /etc/caddy/Caddyfile and replace orion.YOUR_DOMAIN. Caddy gets
# and renews the HTTPS certificate automatically (the DNS record must already
# point at this server and ports 80/443 must be open), redirects HTTP to
# HTTPS, and passes WebSocket upgrades and the Host/Origin headers through
# unchanged. Orion OS listens on 127.0.0.1:8080 (LTF_MODE=production).
# See docs/deployment.md.

orion.YOUR_DOMAIN {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header -Server

	reverse_proxy 127.0.0.1:8080 {
		# Caddy already forwards the original Host and replaces untrusted
		# X-Forwarded-For with the real client address.
		flush_interval -1
	}
}
