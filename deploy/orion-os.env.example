# Orion OS — production environment file.
# Install as /etc/orion-os/orion-os.env (owner root, mode 0600).
# Replace orion.YOUR_DOMAIN with your real hostname. No secrets go in this
# file: the access key lives in its own file (see below).

LTF_MODE=production
LTF_BIND=127.0.0.1
PORT=8080

# The website's hostname, exactly as typed in the browser (no https://, no port).
LTF_ALLOWED_HOSTS=orion.YOUR_DOMAIN

# The access key is NOT set here. Create it once:
#   openssl rand -base64 32 | sudo tee /etc/orion-os/access-key >/dev/null
#   sudo chmod 0600 /etc/orion-os/access-key
# The systemd unit hands it to Orion OS via LoadCredential. Without systemd,
# set LTF_ACCESS_KEY_FILE to a file only the service user can read.
# LTF_ACCESS_KEY_FILE=/etc/orion-os/access-key

# How long "Keep me signed in" lasts (hours, 1–720). Sign-ins without it end
# when the browser closes (and after 12 h at most).
# LTF_SESSION_HOURS=168

LTF_DATA_DIR=/var/lib/orion-os
LTF_STATIC_DIR=/opt/orion-os/static
LTF_CONTENT_DIR=/opt/orion-os/content

# The reverse proxy overwrites X-Forwarded-For, so it is safe to trust.
LTF_TRUST_PROXY_HEADERS=1

# Server-side web fetching (Orion browser "isolated" mode, /net thumbnails and
# favicons) is OFF: otherwise anyone signed in could load other websites
# through your server, which on a school or work network would get around
# the network's filtering. App windows still open sites directly in the
# browser, under the network's normal rules. Thumbnails/favicons show a
# placeholder. Set to 1 only if you understand and accept that.
LTF_PROXY=0

# Optional
# LTF_NETCHECK_URL=https://www.gstatic.com/generate_204
# YOUTUBE_API_KEY=YOUR_SECRET   (a secret — fine here only because this file is root-only, 0600)
RUST_LOG=ltf_os=info,tower_http=warn
