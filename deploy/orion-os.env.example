# Orion OS private beta — environment file (e.g. /etc/orion-os/orion-os.env,
# mode 0600, owned by root). Values here are placeholders.

LTF_MODE=beta
LTF_BIND=127.0.0.1
PORT=8080

# The public hostname(s) of the beta, exactly as typed in the browser.
LTF_ALLOWED_HOSTS=YOUR_DOMAIN

# Private access key: keep it in its own root-owned 0600 file, never here.
# Generate one with:  openssl rand -base64 32 > /etc/orion-os/access-key
# The systemd unit passes it via LoadCredential; without systemd, point
# LTF_ACCESS_KEY_FILE at a file only the service user can read.
# LTF_ACCESS_KEY_FILE=/etc/orion-os/access-key
# LTF_SESSION_HOURS=168

LTF_DATA_DIR=/var/lib/orion-os
LTF_STATIC_DIR=/opt/orion-os/static
LTF_CONTENT_DIR=/opt/orion-os/content

# Behind the reverse proxy above (which overwrites X-Forwarded-For).
LTF_TRUST_PROXY_HEADERS=1

# Optional
# LTF_NETCHECK_URL=https://www.gstatic.com/generate_204
# YOUTUBE_API_KEY=YOUR_SECRET
RUST_LOG=ltf_os=info,tower_http=warn
